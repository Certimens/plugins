# Ce qui n'appartient à aucun agent. Chaque projet ignore ce qu'il produit lui-même, dans son
# propre .gitignore : la racine n'a ni outillage ni dépendance.

# macOS, sur les postes qui servent à la conversion Safari et aux essais Word.
.DS_Store

# Claude Code : CLAUDE.md et .claude/skills/ font partie du dépôt — ils décrivent les règles
# que les quatre agents partagent. Seules les permissions propres à une machine restent dehors.
.claude/settings.local.json
