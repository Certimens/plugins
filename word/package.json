{
  "name": "@certimens/word",
  "private": true,
  "description": "Agent Certimens — complément Office pour Word",
  "license": "Apache-2.0",
  "scripts": {
    "lint": "npm run lint:js && npm run lint:html",
    "lint:js": "eslint .",
    "lint:html": "html-validate src/*.html",
    "lint:manifest": "office-addin-manifest validate dist/word/manifest.xml",
    "test": "node --test \"tests/*.test.mjs\"",
    "build": "node build.mjs",
    "serve": "node serve.mjs",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "html-validate": "11.16.1",
    "office-addin-dev-certs": "3.0.1",
    "office-addin-manifest": "3.0.1"
  }
}
