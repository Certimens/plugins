{
  "name": "@certimens/word",
  "private": true,
  "description": "Agent Certimens — complément Office pour Word",
  "license": "AGPL-3.0-only",
  "scripts": {
    "lint": "npm run lint:js && npm run lint:types && npm run lint:html && npm run lint:deps",
    "lint:js": "eslint .",
    "lint:types": "tsc -p jsconfig.json",
    "lint:html": "html-validate src/*.html",
    "lint:deps": "node check-install-scripts.mjs",
    "lint:manifest": "office-addin-manifest validate dist/word/manifest.xml",
    "test": "node --test \"tests/*.test.mjs\"",
    "coverage": "node --test --experimental-test-coverage --test-coverage-exclude='tests/**' --test-coverage-lines=65 \"tests/*.test.mjs\"",
    "build": "node build.mjs",
    "update": "npx --yes npm-check-updates@latest -u && npm install",
    "serve": "node serve.mjs",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/office-js": "1.0.613",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "html-validate": "11.17.0",
    "office-addin-dev-certs": "3.0.1",
    "office-addin-manifest": "3.0.1",
    "typescript": "7.0.2"
  }
}
