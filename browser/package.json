{
  "name": "@certimens/browser",
  "private": true,
  "description": "Agent Certimens — extension navigateur MV3 (Chrome, Firefox, Safari, Edge, Opera)",
  "license": "AGPL-3.0-only",
  "scripts": {
    "lint": "npm run lint:js && npm run lint:types && npm run lint:css && npm run lint:html && npm run lint:sh && npm run lint:deps",
    "lint:js": "eslint .",
    "lint:types": "tsc -p jsconfig.json && tsc -p jsconfig.worker.json",
    "lint:css": "stylelint src/ui.css",
    "lint:html": "html-validate src/*.html",
    "lint:sh": "if command -v shellcheck >/dev/null; then shellcheck safari.sh; else echo \"shellcheck missing: safari.sh lint skipped (the GitHub runners have it).\"; fi",
    "lint:deps": "node check-install-scripts.mjs",
    "lint:amo": "web-ext lint --source-dir dist/firefox --self-hosted=false --warnings-as-errors",
    "test": "node --test \"tests/*.test.mjs\"",
    "test:host": "node --test \"tests/host/*.test.mjs\"",
    "coverage": "node --test --experimental-test-coverage --test-coverage-exclude='tests/**' --test-coverage-lines=72 \"tests/*.test.mjs\"",
    "build": "node build.mjs",
    "update": "npx --yes npm-check-updates@latest -u && npm install",
    "safari": "./safari.sh",
    "publish:chrome": "publish-extension --chrome-zip dist/chrome.zip",
    "publish:firefox": "publish-extension --firefox-zip dist/firefox.zip",
    "publish:edge": "publish-extension --edge-zip dist/chrome.zip",
    "publish:opera": "publish-extension --opera-zip dist/chrome.zip",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/chrome": "0.3.5",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "html-validate": "11.16.2",
    "playwright": "1.64.0",
    "publish-browser-extension": "6.2.0",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0",
    "typescript": "7.0.2",
    "web-ext": "10.7.0"
  }
}
