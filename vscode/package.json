{
  "name": "certimens",
  "displayName": "%extension.displayName%",
  "description": "%extension.description%",
  "version": "0.0.0",
  "publisher": "certimens",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/Certimens/plugins.git",
    "directory": "vscode"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Education",
    "Other"
  ],
  "keywords": [
    "certimens",
    "authorship",
    "rédaction",
    "intégrité"
  ],
  "icon": "src/media/icon128.png",
  "main": "./src/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true,
      "description": "%capability.untrustedWorkspaces%"
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "%capability.virtualWorkspaces%"
    }
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "certimens",
          "title": "%view.title%",
          "icon": "src/media/shield.svg"
        }
      ]
    },
    "views": {
      "certimens": [
        {
          "type": "webview",
          "id": "certimens.panel",
          "name": "%view.name%"
        }
      ]
    },
    "commands": [
      {
        "command": "certimens.login",
        "title": "%command.login%"
      },
      {
        "command": "certimens.logout",
        "title": "%command.logout%"
      },
      {
        "command": "certimens.submit",
        "title": "%command.submit%"
      },
      {
        "command": "certimens.togglePause",
        "title": "%command.togglePause%"
      },
      {
        "command": "certimens.flush",
        "title": "%command.flush%"
      },
      {
        "command": "certimens.focusPanel",
        "title": "%command.focusPanel%"
      }
    ],
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "certimens.exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/node_modules/**",
            "**/.git/**",
            "**/dist/**",
            "**/build/**",
            "**/out/**",
            "**/target/**",
            "**/vendor/**",
            "**/.venv/**",
            "**/__pycache__/**",
            "**/*.min.*",
            "**/*.lock",
            "**/*-lock.json"
          ],
          "markdownDescription": "%configuration.exclude%"
        }
      }
    }
  },
  "scripts": {
    "lint": "npm run lint:js && npm run lint:types && npm run lint:deps",
    "lint:js": "eslint .",
    "lint:types": "tsc -p jsconfig.json",
    "lint:deps": "node check-install-scripts.mjs @vscode/vsce-sign",
    "test": "node --test \"tests/*.test.mjs\"",
    "test:host": "node tests/host/run.mjs",
    "coverage": "node --test --experimental-test-coverage --test-coverage-exclude='tests/**' --test-coverage-lines=73 \"tests/*.test.mjs\"",
    "build": "node build.mjs",
    "update": "npx --yes npm-check-updates@latest -u --reject @types/vscode && npm install",
    "dev": "code --extensionDevelopmentPath=.",
    "publish": "vsce publish --packagePath dist/certimens-vscode.vsix",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.5",
    "@types/vscode": "1.90.0",
    "@vscode/test-electron": "2.5.2",
    "@vscode/vsce": "4.0.0",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "typescript": "7.0.2"
  }
}
